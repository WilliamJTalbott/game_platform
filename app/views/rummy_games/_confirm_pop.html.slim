- if can_meld || can_discard
  .confirm-pop
    p.confirm-pop__text
      - if can_meld
        | Create a meld with these #{selected_count} cards?
      - else
        | Discard this card?

    - if can_meld
      button.btn.btn--primary type="button" data-action="click->rummy-turn#meld" Create meld ✓
    - if can_discard
      button.btn.btn--primary type="button" data-action="click->rummy-turn#discardSelected" Discard

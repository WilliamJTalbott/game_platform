.felt
  .felt-zone.felt-zone--piles
    span.felt-zone__label Piles

    .felt-zone__body
      = render "rummy_games/pile", card: nil, label: "Stock", action: "draw_stock", enabled: can_draw
      = render "rummy_games/pile",
              card: discard_top,
              label: "Discard",
              action: "draw_discard",
              enabled: can_draw && discard_top.present?

  .felt-zone.felt-zone--melds
    span.felt-zone__label Shared melds

    .felt-zone__body
      - melds.each_with_index do |meld, index|
        = render "rummy_games/meld", meld: meld, index: index, can_select: can_select

  = render "rummy_games/confirm_pop"

button.meld class=[("meld--selected" if meld.selected), ("meld--faded" if meld.faded)] type="button" disabled=(!meld.can_lay_off) data-action="click->rummy-turn#layOff" data-rummy-turn-meld-index-param=index
  .meld__header
    span.meld__kind = meld.kind
    span.meld__owner = meld.owner

  .meld__cards
    - meld.cards.each do |card|
      .card-container.card-container--small
        .playing-card
          = image_tag("dark_cards/#{card.rank.downcase}_#{card.suit.downcase}.svg")

.game id=dom_id(game_info.game)
  / Board
  .panel.panel--board

    .panel__header.header--top
      h2 = game_info.name
    .panel__body

      .op-stack.items-stretch.gap-xs
        p Players
        - if game_info.started?
          = render partial: "go_fish_games/opponent", collection: game_info.opponents, as: :opponent

  / Feed
  .panel.panel--feed.panel--side

    .panel__header.header--top
      p Game Feed

    .panel__body
      - if game_info.started?
        .feed__messages
          = render partial: "go_fish_games/message", collection: game_info.messages, as: :message

        = simple_form_for game_info.form,
                as: :turn,
                url: game_turns_path(game_info.game),
                html: {class: "request-form"} do |f|

          = f.input :player_name,
                  as: :select,
                  collection: game_info.opponent_names,
                  include_blank: false

          = f.input :rank,
                  as: :select,
                  collection: game_info.ranks,
                  include_blank: false

          = f.button :submit,
                  "Ask for card",
                  class: "btn btn--primary",
                  disabled: !game_info.user_turn?
  / Hand
  .panel.panel--hand.panel--base

    .panel__header
      p Your Hand

    .panel__body.hand
      - if game_info.started?
        = render partial: "go_fish_games/card", collection: game_info.cards, as: :card

  / Books
  .panel.panel--books.panel--side.panel--base
    .panel__header
      p Books

    .panel__body

  - if game_info.winner
    .overlay.card
      h1 = "#{game_info.winner.email_address} wins!"
      form action="/reset" method="POST"
        button.btn.btn--primary name='reset_button' type="submit" Restart Game

  - unless game_info.started?
    .overlay.card
      h1 Waiting for players...
      = button_to "Start Game", start_game_path(game_info.game), method: :post, class: "btn btn--primary"

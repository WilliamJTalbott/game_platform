div.game
  / Board
  div.panel.panel--board

    div.panel__header.header--top
      h2 = @game_info.name
    div.panel__body

      div.op-stack.items-stretch.gap-xs
        p Players
        - if @game_info.started?
          = render partial: "go_fish_games/opponent", collection: @game_info.opponents, as: :opponent

  / Feed
  div.panel.panel--feed.panel--side

    div.panel__header.header--top
      p Game Feed

    div.panel__body
      - if @game_info.started?
        div.feed__messages
          = render partial: "go_fish_games/message", collection: @game_info.messages, as: :message

        = simple_form_for :turn, url: game_turns_path(@game_info.game), html: {class: "request-form"} do |f|
          = f.input :player_name, as: :select, collection: @game_info.opponent_names, selected: @game_info.opponent_names.first
          = f.input :rank, as: :select, collection: @game_info.ranks, selected: @game_info.ranks.first
          = f.button :submit, "Ask for card", class: "btn btn--primary", disabled: !@game_info.user_turn?
  / Hand
  div.panel.panel--hand.panel--base

    div.panel__header
      p Your Hand

    div.panel__body.hand
      - if @game_info.started?
        = render partial: "go_fish_games/card", collection: @game_info.cards, as: :card

    / # @game.player.cards

  / Books
  div.panel.panel--books.panel--side.panel--base
    div.panel__header
      p Books

    div.panel__body

  - if @game_info.winner
    div.overlay.card
      h1 = "#{@game_info.winner.email_address} wins!"
      form action="/reset" method="POST"
        button.btn.btn--primary name='reset_button' type="submit" Restart Game

  - unless @game_info.started?
    div.overlay.card
      h1 Waiting for players...
      = button_to "Start Game", start_game_path(@game_info.game), method: :post, class: "btn btn--primary"

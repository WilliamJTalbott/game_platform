doctype html
html
  head
    = render "head"

  body.op-page(
    data-controller="service-worker"
    data-service-worker-url-value=pwa_service_worker_path(format: :js)
  )
    / The stable target a turbo_stream can replace to raise a .popup notice. It
    / lives in the layout, outside any page region a turbo_stream response might
    / itself replace — a target inside such a region would be destroyed by the
    / very response trying to write to it.
    = render "shared/flash", message: nil

    .sidebar
      = render "sidebar"

    .op-page__main
      = turbo_frame_tag "modal"
      = yield
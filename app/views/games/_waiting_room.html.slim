.overlay.card.waiting-room
  h1.waiting-room__title = lobby.name
  p.waiting-room__meta
    = "#{lobby.type_label} · #{lobby.player_count} players"

  ul.waiting-room__roster
    - lobby.players.each do |row|
      li.waiting-room__player
        | • #{row.name}
        - if row.host?
          span.waiting-room__badge
            | (host)
        - if row.you?
          span.waiting-room__badge
            | (you)

  p.waiting-room__status = lobby.status_line

  .waiting-room__actions
    button.btn.btn--secondary data-controller="clipboard" data-clipboard-value-value=lobby.invite_url data-action="clipboard#copy"
      | Copy invite link
    - if lobby.show_start?
      = button_to "Start Game", start_game_path(lobby.game), method: :post, class: "btn btn--primary"

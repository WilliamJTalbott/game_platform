.modal-wrapper.modal-wrapper--active
  .modal-wrapper__backdrop
  .modal.modal--login
    = simple_form_for @game do |f|
      .modal__header
        | Setup Game

      .modal__body
          = f.input :name
          = f.input :type, collection: Game.game_types.keys, selected: Game.game_types.keys.first
      .modal__footer
        = f.button :submit, "Create Game"